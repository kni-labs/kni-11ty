{
  "name": "kni-11ty",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "npm-run-all --parallel css:watch eleventy:serve",
    "eleventy:serve": "eleventy --serve",
    "build": "npm run css:build && eleventy",
    "start": "npm-run-all --parallel css:watch eleventy:serve",
    "css:build": "sass src/styles:dist/assets/css --no-source-map && postcss dist/assets/css/*.css --dir dist/assets/css",
    "css:watch": "sass --watch src/styles:dist/assets/css --no-source-map",
    "postinstall": "node ./scripts/kni-cascade-postinstall.js",
    "lint:css": "stylelint 'src/**/*.(css|scss)' || true",
    "format:css": "prettier --write 'src/**/*.(css|scss)' || true"
  },
  "packageManager": "pnpm@10",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "autoprefixer": "^10.4.0",
    "kni-cascade": "github:kni-labs/kni-cascade",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.0",
    "postcss-cli": "^9.0.0",
    "prettier": "^2.8.0",
    "sass": "^1.66.0",
    "stylelint": "^14.16.0"
  },
  "description": "An 11ty starter scaffold using the kni-cascade CSS foundation."
}
